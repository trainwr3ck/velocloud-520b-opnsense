diff --git a/sys/dev/e1000/e1000_82575.c b/sys/dev/e1000/e1000_82575.c
index 47b80063..c32ae62d 100644
--- a/sys/dev/e1000/e1000_82575.c
+++ b/sys/dev/e1000/e1000_82575.c
@@ -196,6 +196,18 @@ static s32 e1000_init_phy_params_82575(struct e1000_hw *hw)
 	E1000_WRITE_REG(hw, E1000_CTRL_EXT, ctrl_ext);
 	e1000_reset_mdicnfg_82580(hw);
 
+	/*
+	 * VeloCloud probe: if this is an I354 on a VeloCloud board,
+	 * igb_vc_probe() overrides phy.ops.read_reg/write_reg to use
+	 * GPIO bitbang MDIO and pre-fills phy.addr and phy.id.
+	 * Returns 1 if VeloCloud WAN port detected (skip MDIO setup
+	 * and PHY ID detection below), 0 otherwise.
+	 */
+	{ extern s32 igb_vc_probe(struct e1000_hw *);
+	  if (igb_vc_probe(hw))
+		goto vc_phy_ready;
+	}
+
 	if (e1000_sgmii_active_82575(hw) && !e1000_sgmii_uses_mdio_82575(hw)) {
 		phy->ops.read_reg = e1000_read_phy_reg_sgmii_82575;
 		phy->ops.write_reg = e1000_write_phy_reg_sgmii_82575;
@@ -220,6 +232,26 @@ static s32 e1000_init_phy_params_82575(struct e1000_hw *hw)
 
 	/* Set phy->phy_addr and phy->id. */
 	ret_val = e1000_get_phy_id_82575(hw);
+vc_phy_ready:
+
+	/*
+	 * VeloCloud switch port (func0/func1): phy->id is 0,
+	 * media_type is internal_serdes.  No PHY to initialize ->
+	 * the 88E6176 switch is managed via e6000sw/mdio, not
+	 * the e1000 PHY layer.
+	 *
+	 * Override setup_physical_interface to use forced SGMII link.
+	 * The I354-to-88E6176 is MAC-to-MAC SGMII which requires
+	 * forced 1000/FD with PCS autoneg disabled.
+	 */
+	if (phy->id == 0 &&
+	    phy->media_type == e1000_media_type_internal_serdes) {
+		{ extern s32 igb_vc_setup_sgmii_forced(struct e1000_hw *);
+		  hw->mac.ops.setup_physical_interface =
+		      igb_vc_setup_sgmii_forced; }
+		DEBUGOUT("VeloCloud switch port -> skipping PHY init\n");
+		return E1000_SUCCESS;
+	}
 
 	/* Verify phy id and set remaining function pointers */
 	switch (phy->id) {
@@ -301,6 +333,8 @@ static s32 e1000_init_phy_params_82575(struct e1000_hw *hw)
 	case M88E1512_E_PHY_ID:
 	{
 		ret_val = e1000_initialize_M88E1512_phy(hw);
+		{ extern void igb_vc_configure_leds(struct e1000_hw *);
+		  igb_vc_configure_leds(hw); }
 		break;
 	}
 	case M88E1543_E_PHY_ID:
@@ -736,8 +770,11 @@ static s32 e1000_phy_hw_reset_sgmii_82575(struct e1000_hw *hw)
 	if (ret_val)
 		goto out;
 
-	if (phy->id == M88E1512_E_PHY_ID)
+	if (phy->id == M88E1512_E_PHY_ID) {
 		ret_val = e1000_initialize_M88E1512_phy(hw);
+		{ extern void igb_vc_configure_leds(struct e1000_hw *);
+		  igb_vc_configure_leds(hw); }
+	}
 out:
 	return ret_val;
 }
